{
  "name": "living-colors",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --port 1607",
    "build": "next build",
    "start": "next start --port 1607",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:gpu": "tsx --test tests/gpu/*.test.mts",
    "check:shaders": "vgpu check lib/gpu/shaders/petal-tissue.wgsl --require-validation && vgpu check lib/gpu/shaders/studio-lighting.wgsl --require-validation"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.0",
    "vgpu": "0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vgpu/wgsl": "0.4.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
